.DS_Store
Thumbs.db

# Override global gitignore — track slash commands
!.claude/
!.claude/commands/
!.claude/commands/*.md

# Nested tool state under site/ — not slash commands, don't track
site/.claude/

# Security - secret leak prevention
.env.*
*.pem
*.key
credentials.*
secrets.*

# --- lailara engagement scaffold ---
# Client engagement data is runtime-only: never commit it, never deploy it.
client-data/
client-output/
/engagement.yml
/engagement.yaml
# (engagement.demo.yml and engagement.example.yml stay committable)
